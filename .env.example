# ---------------------------------------------------------------------------
# Your ESPN league
# ---------------------------------------------------------------------------
# LEAGUE_ID is in the URL when you view your league:
#   https://fantasy.espn.com/football/league?leagueId=123456
BENCHCOACH_LEAGUE_ID=
BENCHCOACH_SEASON=2026

# Your team's ID within that league (1, 2, 3...). Leave blank and the CLI will
# list the teams so you can find yours.
BENCHCOACH_TEAM_ID=

# ---------------------------------------------------------------------------
# Private league credentials  (PUBLIC LEAGUES NEED NEITHER)
# ---------------------------------------------------------------------------
# These are ESPN *session cookies*. They are full account access, not scoped
# API tokens. Treat them like a password:
#   - put them here, in this file, which is gitignored
#   - never paste them into a chat, an issue, or a screenshot
#   - rotate them by logging out of ESPN, which invalidates them
#
# To find them: log in to fantasy.espn.com, open DevTools (Cmd+Opt+I) ->
# Application -> Cookies -> https://www.espn.com, and copy these two values.
# SWID includes the curly braces.
BENCHCOACH_ESPN_S2=
BENCHCOACH_SWID=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# While true, nothing is ever written to ESPN -- proposed changes are logged
# and displayed only. Leave it on until you have watched it propose a few
# swaps you agree with.
BENCHCOACH_DRY_RUN=true

# ---------------------------------------------------------------------------
# SMS approvals  (optional -- without these, messages print to the console)
# ---------------------------------------------------------------------------
# A Twilio TRIAL account is enough to text your own verified number, with no
# A2P 10DLC registration, which is exactly this use case. Steps:
#   1. Sign up at twilio.com and verify your own mobile number
#   2. Get a trial phone number (Console -> Phone Numbers -> Buy a number)
#   3. Copy the Account SID and Auth Token from the Console dashboard
BENCHCOACH_TWILIO_ACCOUNT_SID=
BENCHCOACH_TWILIO_AUTH_TOKEN=
BENCHCOACH_TWILIO_FROM_NUMBER=+15550001111
BENCHCOACH_MY_PHONE_NUMBER=+15555556666

# For replies to reach you, Twilio needs a public URL to POST to. In
# development: `cloudflared tunnel --url http://localhost:8000` then set the
# https URL it prints here, and point your Twilio number's "A MESSAGE COMES IN"
# webhook at <that URL>/sms/inbound.
# This must match exactly -- Twilio signs the full URL, and a mismatch fails
# signature validation rather than failing open.
BENCHCOACH_PUBLIC_BASE_URL=

# How long an approval stays valid. A lineup change after kickoff is worse
# than no change at all.
BENCHCOACH_APPROVAL_TTL_MINUTES=90

# ---------------------------------------------------------------------------
# Telegram approvals  (preferred -- free, instant, real [YES]/[NO] buttons)
# ---------------------------------------------------------------------------
# Far less friction than SMS: no carrier registration, no public webhook URL.
#   1. Message @BotFather in Telegram, send /newbot, follow the prompts
#   2. Tap the token it gives you (tapping copies the whole string)
#   3. Open your new bot and send it anything -- a bot cannot message you first
# The chat id is discovered for you by `python -m cli telegram-setup`.
BENCHCOACH_TELEGRAM_BOT_TOKEN=
BENCHCOACH_TELEGRAM_CHAT_ID=
